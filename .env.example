# Copia este archivo como .env.local y completa los valores desde Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_SUPABASE_PUBLISHABLE_O_ANON_KEY

# Opcional: nombre mostrado en la web
NEXT_PUBLIC_RESTAURANT_NAME=Sabor Brasas
NEXT_PUBLIC_DELIVERY_FEE=7.00
NEXT_PUBLIC_PIX_KEY=

# Para habilitar pagos reales debes integrar un proveedor de pagos.
# Nunca guardes claves secretas en variables NEXT_PUBLIC_*.

# SOLO SERVIDOR. Supabase > Project Settings > API > service_role/secret key.
# Nunca la uses en código cliente ni la publiques en GitHub.
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SECRETA_DE_SERVIDOR
